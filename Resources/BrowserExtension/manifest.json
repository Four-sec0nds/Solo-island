{
  "manifest_version": 3,
  "name": "Solo Island \u2014 web agents",
  "version": "0.8.0",
  "description": "Local activity and elapsed time for supported Claude and ChatGPT/Codex pages.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://www.claude.ai/*",
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*"
      ],
      "js": [
        "observer.js"
      ],
      "run_at": "document_idle"
    }
  ]
}